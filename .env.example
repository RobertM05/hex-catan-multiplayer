# Copy to .env locally. Leave unset for guest-only play (no Supabase required).

PORT=3000

# AUTH-01 — optional Supabase (Google + magic link). Never commit real keys.
# Frontend origin used for magic-link / OAuth redirect allow-list in the Supabase dashboard:
#   http://localhost:3000
#   https://YOUR_PRODUCTION_DOMAIN
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Used to load profiles and insert matches. Do not expose to the browser.
SUPABASE_SERVICE_ROLE=
# HS256 secret from Supabase Project Settings → API → JWT Secret.
# Invalid access tokens are rejected when this is set.
SUPABASE_JWT_SECRET=
